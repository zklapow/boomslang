<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.hubspot</groupId>
    <artifactId>boomslang-parent</artifactId>
    <version>0.1.1-SNAPSHOT</version>
  </parent>

  <artifactId>boomslang-benchmarks</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>

  <dependencies>
    <dependency>
      <groupId>com.dylibso.chicory</groupId>
      <artifactId>compiler</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.jimfs</groupId>
      <artifactId>jimfs</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hubspot</groupId>
      <artifactId>boomslang</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.openjdk.jmh</groupId>
              <artifactId>jmh-generator-annprocess</artifactId>
              <version>${dep.jmh.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <finalName>benchmarks</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.openjdk.jmh.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>linux-wasm-aot</id>
      <activation>
        <property>
          <name>linux.wasm.aot</name>
        </property>
      </activation>
      <properties>
        <linux.wasm.aot.wasmFile>${project.basedir}/../spikes/linux-wasm/build/joel-demo/vmlinux.stripped.wasm</linux.wasm.aot.wasmFile>
        <linux.wasm.aot.className>com.hubspot.boomslang.benchmarks.compiled.JoelLinuxWasm</linux.wasm.aot.className>
        <linux.wasm.aot.userWasmFile>${project.basedir}/../spikes/linux-wasm/build/joel-demo/user-executables/01-task_swapper_0_0x2b3a80_.wasm</linux.wasm.aot.userWasmFile>
        <linux.wasm.aot.userClassName>com.hubspot.boomslang.benchmarks.compiled.JoelUserWasm</linux.wasm.aot.userClassName>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>com.dylibso.chicory</groupId>
            <artifactId>chicory-compiler-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>compile-linux-wasm</id>
                <goals>
                  <goal>compile</goal>
                </goals>
                <configuration>
                  <wasmFile>${linux.wasm.aot.wasmFile}</wasmFile>
                  <name>${linux.wasm.aot.className}</name>
                  <interpreterFallback>WARN</interpreterFallback>
                  <targetSourceFolder>${project.build.directory}/generated-sources/annotations</targetSourceFolder>
                  <targetClassFolder>${project.build.outputDirectory}</targetClassFolder>
                  <targetWasmFolder>${project.build.outputDirectory}</targetWasmFolder>
                </configuration>
              </execution>
              <execution>
                <id>compile-linux-wasm-user</id>
                <goals>
                  <goal>compile</goal>
                </goals>
                <configuration>
                  <wasmFile>${linux.wasm.aot.userWasmFile}</wasmFile>
                  <name>${linux.wasm.aot.userClassName}</name>
                  <interpreterFallback>WARN</interpreterFallback>
                  <targetSourceFolder>${project.build.directory}/generated-sources/annotations</targetSourceFolder>
                  <targetClassFolder>${project.build.outputDirectory}</targetClassFolder>
                  <targetWasmFolder>${project.build.outputDirectory}</targetWasmFolder>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
